# Supabase Project Settings > API で取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 絶対にブラウザへ公開しない（サーバー専用）
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console (https://console.anthropic.com/) で発行
ANTHROPIC_API_KEY=

# Voyage AI (https://dash.voyageai.com/) で発行
VOYAGE_API_KEY=

# Resend (https://resend.com/) で発行
RESEND_API_KEY=
# 有人対応が必要になった際の通知先メールアドレス
ESCALATION_EMAIL_TO=

# 開発時に営業時間判定をテストするための時刻上書き（ISO8601、未設定なら現在時刻を使用）
MOCK_NOW=
